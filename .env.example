# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- Voice: ElevenLabs ----
# elevenlabs.io > profile > API Keys
ELEVENLABS_API_KEY=
# Printed by `pnpm agents:create`. Paste both back here, then restart.
ELEVENLABS_AGENT_CUSTOMER=
ELEVENLABS_AGENT_HELPER=
# Voices > My Voices > three dots > Copy Voice ID.
# Leave empty to fall back to the stock voices in src/persona/config.json.
ELEVENLABS_VOICE_CUSTOMER=
ELEVENLABS_VOICE_HELPER=

# ---- The Brain: Gemini ----
# aistudio.google.com/apikey. Comma-separated, tried in order, rotated on quota errors.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Used only if every Gemini key fails.
ANTHROPIC_API_KEY=

# ---- Payments (optional) ----
# Stripe test key (sk_test_...). Empty gives the "Pay (demo)" button instead.
STRIPE_SECRET_KEY=

# ---- App ----
# The public URL. Set to your tunnel or deployment so Stripe returns and QR links resolve.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Local file by default. For a deploy, use a Turso URL and add DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/grandma.db
# DATABASE_AUTH_TOKEN=
GRANDMA_NAME=Grandma
