# ElevenLabs (profile > API keys). Agent IDs are printed by `pnpm agents:create`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_CUSTOMER=
ELEVENLABS_AGENT_HELPER=
# Voice IDs from Voices > My Voices (leave empty to use the stock voices)
ELEVENLABS_VOICE_CUSTOMER=
ELEVENLABS_VOICE_HELPER=

# Brain. Comma-separated Gemini keys are tried in order and rotated on quota errors.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback when every Gemini key fails.
ANTHROPIC_API_KEY=

# Optional. Leave empty for the "Pay (demo)" button.
STRIPE_SECRET_KEY=

# Set to the cloudflared URL for the demo so Stripe and QR links point at it.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=file:./data/grandma.db
GRANDMA_NAME=Grandma
